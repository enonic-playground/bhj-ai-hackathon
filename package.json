{
  "name": "hac-man",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Maze-chase arcade action combined with letter-by-letter word discovery.",
  "license": "Apache-2.0",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.build.json && vite build",
    "build:fixture": "tsc --noEmit -p tsconfig.build.json && vite build --mode fixture --outDir dist-fixture",
    "preview": "vite preview",
    "preview:fixture": "vite preview --outDir dist-fixture",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.3",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
